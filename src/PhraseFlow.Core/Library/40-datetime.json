{
  "id": "datetime",
  "order": 40,
  "name": "Date & time",
  "description": "Current date and time in many formats, plus relative dates.",
  "defaults": { "trigger": "delimiter", "case": "insensitive" },
  "snippets": [
    [";date", "{date}", "Short date (your regional format)"],
    [";ldate", "{date:D}", "Long date"],
    [";today", "{date:dddd, MMMM d, yyyy}", "Today, spelled out"],
    [";isodate", "{date:yyyy-MM-dd}", "ISO 8601 date"],
    [";usdate", "{date:MM/dd/yyyy}", "US date"],
    [";eudate", "{date:dd/MM/yyyy}", "European date"],
    [";dedate", "{date:dd.MM.yyyy}", "German date"],
    [";mdy", "{date:MMMM d, yyyy}", "Month day, year"],
    [";dmy", "{date:d MMMM yyyy}", "Day month year"],
    [";ordinal", "{date:dddd, MMMM} {ordinal:{date:%d}}", "Date with ordinal day (October 7th)"],
    [";time", "{time}", "Short time (your regional format)"],
    [";time24", "{time:HH:mm}", "24-hour time"],
    [";time12", "{time:h:mm tt}", "12-hour time"],
    [";timesec", "{time:HH:mm:ss}", "Time with seconds"],
    [";now", "{datetime:yyyy-MM-dd HH:mm}", "Date and time"],
    [";dt", "{datetime}", "Date and time (regional)"],
    [";isonow", "{datetime:iso}", "ISO 8601 local timestamp"],
    [";utc", "{utc}", "UTC timestamp"],
    [";ts", "{date:yyyyMMdd-HHmmss}", "Compact timestamp"],
    [";unix", "{unix}", "Unix timestamp"],
    [";stamp", "[{date:yyyy-MM-dd HH:mm}] {user}: ", "Log stamp"],
    [";tomorrow", "{date:dddd, MMMM d|+1d}", "Tomorrow"],
    [";yesterday", "{date:dddd, MMMM d|-1d}", "Yesterday"],
    [";nextweek", "{date:dddd, MMMM d|+1w}", "One week from today"],
    [";in2w", "{date:dddd, MMMM d|+2w}", "Two weeks from today"],
    [";nextmonth", "{date:MMMM yyyy|+1M}", "Next month"],
    [";nextbd", "{date:dddd, MMMM d|+1bd}", "Next business day"],
    [";in5bd", "{date:dddd, MMMM d|+5bd}", "Five business days from today"],
    [";somdate", "{date:MMMM d, yyyy|som}", "First day of this month"],
    [";eomdate", "{date:MMMM d, yyyy|eom}", "Last day of this month"],
    [";monday", "{date:MMMM d|sow}", "Monday of this week"],
    [";friday", "{date:MMMM d|sow +4d}", "Friday of this week"],
    [";dow", "{date:dddd}", "Day of the week"],
    [";month", "{date:MMMM}", "Month name"],
    [";year", "{date:yyyy}", "Year"],
    [";week", "week {week}", "ISO week number"],
    [";quarter", "Q{quarter} {date:yyyy}", "Quarter"],
    [";fy", "FY{date:yy}", "Fiscal year (calendar)"],
    [";due", "Due: {pickdate:Due date|dddd, MMMM d}", "Pick a due date"]
  ]
}
