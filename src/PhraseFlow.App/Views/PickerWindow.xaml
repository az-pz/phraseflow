<Window x:Class="PhraseFlow.App.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhraseFlow search" Width="680" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Margin="14" CornerRadius="10" BorderThickness="1"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.32" />
        </Border.Effect>
        <DockPanel Margin="12">
            <Grid DockPanel.Dock="Top">
                <TextBox x:Name="QueryBox" AutomationProperties.Name="Search snippets" FontSize="16" Padding="34,8,8,8" VerticalContentAlignment="Center" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="QueryHint" Text="Search snippets by keyword, name or text…" IsHitTestVisible="False" FontSize="16"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="36,0,0,0" />
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource CaptionText}" Margin="2,8,0,0">
                <Run Text="↑↓ choose · Enter insert · Ctrl+Enter copy · Esc close" />
                <Run x:Name="CountRun" />
            </TextBlock>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" MaxHeight="110" TextTrimming="CharacterEllipsis" />
            </Border>
            <ListBox x:Name="ResultList" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Results" Height="330" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Keyword}" Style="{StaticResource PickerKeywordText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Preview}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Group}" FontSize="11" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
