<Window x:Class="PhraseFlow.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20,16,20,20">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" MinWidth="96" Padding="12,6" />
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" MinWidth="96" Padding="12,6" />
        </StackPanel>
    </StackPanel>
</Window>
