<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Product>PhraseFlow</Product>
    <Company>PhraseFlow</Company>
    <Authors>PhraseFlow contributors</Authors>
    <Copyright>Copyright © 2026 PhraseFlow contributors</Copyright>
    <Description>A fast, modern text expander for Windows.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
