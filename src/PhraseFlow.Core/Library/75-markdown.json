{
  "id": "markdown",
  "order": 75,
  "name": "Markdown & HTML",
  "description": "Markdown formatting, GitHub alerts, tables and common HTML tags.",
  "defaults": { "trigger": "delimiter", "case": "insensitive" },
  "snippets": [
    [";h1", "# ", "Heading 1"], [";h2", "## ", "Heading 2"], [";h3", "### ", "Heading 3"],
    [";bold", "**{cursor}**", "Bold"], [";italic", "_{cursor}_", "Italic"], [";strike", "~~{cursor}~~", "Strikethrough"],
    [";inline", "`{cursor}`", "Inline code"],
    [";code", "```\n{cursor}\n```", "Code block"],
    [";codecs", "```csharp\n{cursor}\n```", "C# code block"],
    [";codejs", "```javascript\n{cursor}\n```", "JavaScript code block"],
    [";codets", "```typescript\n{cursor}\n```", "TypeScript code block"],
    [";codepy", "```python\n{cursor}\n```", "Python code block"],
    [";codesh", "```bash\n{cursor}\n```", "Bash code block"],
    [";codeps", "```powershell\n{cursor}\n```", "PowerShell code block"],
    [";codejson", "```json\n{cursor}\n```", "JSON code block"],
    [";codesql", "```sql\n{cursor}\n```", "SQL code block"],
    [";codeyaml", "```yaml\n{cursor}\n```", "YAML code block"],
    [";mdlink", "[{cursor}]({clipboard})", "Link to the URL on the clipboard"],
    [";mdimg", "![{cursor}]({clipboard})", "Image from the URL on the clipboard"],
    [";mdtable", "| Column 1 | Column 2 | Column 3 |\n| --- | --- | --- |\n| {cursor} |  |  |\n", "Table"],
    [";task", "- [ ] ", "Task list item"], [";taskdone", "- [x] ", "Completed task"],
    [";quote", "> ", "Block quote"], [";mdhr", "\n---\n", "Horizontal rule"],
    [";details", "<details>\n<summary>{cursor}</summary>\n\n\n</details>", "Collapsible section"],
    [";ghnote", "> [!NOTE]\n> {cursor}", "GitHub alert: note"],
    [";ghtip", "> [!TIP]\n> {cursor}", "GitHub alert: tip"],
    [";ghimportant", "> [!IMPORTANT]\n> {cursor}", "GitHub alert: important"],
    [";ghwarning", "> [!WARNING]\n> {cursor}", "GitHub alert: warning"],
    [";ghcaution", "> [!CAUTION]\n> {cursor}", "GitHub alert: caution"],
    [";toc", "## Table of contents\n\n- [Introduction](#introduction)\n- [Installation](#installation)\n- [Usage](#usage)\n- [License](#license)\n", "Table of contents"],
    [";readme", "# {input:Project name}\n\n{input:One-line description}\n\n## Installation\n\n```bash\n{cursor}\n```\n\n## Usage\n\n## Contributing\n\nPull requests are welcome.\n\n## License\n\nMIT © {date:yyyy} {fullname}\n", "README template"],
    [";kbd", "<kbd>{cursor}</kbd>", "Keyboard key"],
    [";brtag", "<br>", "Line break tag"],
    [";comment", "<!-- {cursor} -->", "HTML comment"],
    [";div", "<div>{cursor}</div>", "div"],
    [";span", "<span>{cursor}</span>", "span"],
    [";ahref", "<a href=\"{clipboard}\">{cursor}</a>", "Link to the URL on the clipboard"],
    [";img", "<img src=\"{cursor}\" alt=\"\">", "Image tag"],
    [";ul", "<ul>\n  <li>{cursor}</li>\n</ul>", "Unordered list"],
    [";ol", "<ol>\n  <li>{cursor}</li>\n</ol>", "Ordered list"],
    [";table", "<table>\n  <thead>\n    <tr><th>{cursor}</th><th></th></tr>\n  </thead>\n  <tbody>\n    <tr><td></td><td></td></tr>\n  </tbody>\n</table>", "HTML table"],
    [";button", "<button type=\"button\">{cursor}</button>", "Button"],
    [";script", "<script src=\"{cursor}\"></script>", "Script tag"],
    [";stylesheet", "<link rel=\"stylesheet\" href=\"{cursor}\">", "Stylesheet link"],
    [";viewport", "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">", "Viewport meta tag"]
  ]
}
