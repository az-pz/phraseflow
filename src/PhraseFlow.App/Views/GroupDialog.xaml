<Window x:Class="PhraseFlow.App.Views.GroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group settings" Width="540" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20,12,20,20">
        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" />
        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalContentAlignment="Top" />
        <CheckBox x:Name="EnabledBox" Content="Snippets in this group are active" Margin="0,12,0,0" />

        <TextBlock Text="Use these snippets in" Style="{StaticResource FieldLabel}" />
        <RadioButton x:Name="AllAppsRadio" Content="All applications" GroupName="Apps" />
        <RadioButton x:Name="OnlyRadio" Content="Only the applications listed below" GroupName="Apps" />
        <RadioButton x:Name="ExceptRadio" Content="All applications except those listed below" GroupName="Apps" />
        <TextBox x:Name="AppsBox" AcceptsReturn="True" Height="84" Margin="0,8,0,0" VerticalContentAlignment="Top"
                 FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto" ToolTip="Program file names, one per line, e.g. Code.exe" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ComboBox x:Name="RunningAppsBox" Width="260" IsEditable="True" />
            <Button Content="Add" Click="AddApp_Click" Margin="8,0,0,0" Padding="14,5" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Save_Click" MinWidth="96" Padding="12,6" />
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" MinWidth="96" Padding="12,6" />
        </StackPanel>
    </StackPanel>
</Window>
